# Public Expo runtime config.
# Everything prefixed with EXPO_PUBLIC_ is bundled into the client and must be
# treated as public information.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_SCHEME=beisammen
EXPO_PUBLIC_DEFAULT_INSTANCE_ID=beisammen-cloud
EXPO_PUBLIC_DEFAULT_INSTANCE_NAME=Beisammen Cloud
# Public base URL for your backend HTTP actions.
EXPO_PUBLIC_DEFAULT_INSTANCE_URL=https://your-deployment.eu-west-1.convex.site
# Convex client URL used by ConvexReactClient.
EXPO_PUBLIC_DEFAULT_CONVEX_URL=https://your-deployment.eu-west-1.convex.cloud
EXPO_PUBLIC_DEFAULT_AUTH_MODE=native-client
EXPO_PUBLIC_DEFAULT_DEPLOYMENT_KIND=cloud
EXPO_PUBLIC_DEFAULT_AUTH_CLIENT_ID=client_01xxxxxxxxxxxxxxxxxxxxxxxx
# Only needed for hosted-browser mode. Leave empty for native-client PKCE.
EXPO_PUBLIC_DEFAULT_AUTH_SIGN_IN_URL=
# Public EAS project ID required for Expo push token registration on real devices.
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_LOG_LEVEL=trace

# Backend runtime configuration
# Public base URL for the landing page waitlist form.
PUBLIC_INSTANCE_BASE_URL=https://your-deployment.eu-west-1.convex.site
INSTANCE_BASE_URL=https://your-deployment.eu-west-1.convex.site
# Custom URL scheme used when backend HTTP actions redirect back into the app.
PUBLIC_APP_SCHEME=beisammen
# Public base URL for the web frontend used when Convex creates public
# no-install circle links.
PUBLIC_WEB_BASE_URL=https://beisammen.app
# Public instance discovery manifest values served from
# /.well-known/beisammen-instance.json. These are safe to expose to clients.
PUBLIC_INSTANCE_ID=beisammen-cloud
PUBLIC_INSTANCE_NAME=Beisammen Cloud
PUBLIC_CONVEX_URL=https://your-deployment.eu-west-1.convex.cloud
PUBLIC_AUTH_MODE=native-client
PUBLIC_AUTH_CLIENT_ID=client_01xxxxxxxxxxxxxxxxxxxxxxxx
PUBLIC_AUTH_SIGN_IN_URL=
PUBLIC_DEPLOYMENT_KIND=cloud
# Legacy override. Prefer PUBLIC_DEPLOYMENT_KIND; set this only for older envs.
PUBLIC_SELF_HOSTED=false
# Optional JSON array exposed in instance discovery and the mobile billing card.
# Cloud billing is paid-only; do not advertise a free storage-generating plan.
PUBLIC_BILLING_PLANS='[{"id":"cloud_family","name":"Family","monthlyPriceLabel":"$9/month + usage"},{"id":"cloud_archive","name":"Archive","monthlyPriceLabel":"$19/month + storage"}]'
# Minimum mobile app version allowed to connect through instance discovery.
# Custom instance links and `pnpm smoke:beta -- <instance-url> --app-version=...` enforce this.
PUBLIC_MINIMUM_APP_VERSION=0.1.0

# Autumn Convex component is required for cloud deployments. Set the secret in
# Convex with `npx convex env set AUTUMN_SECRET_KEY=am_sk_xxx`.
# Self-hosted deployments ignore these values and have no payments or
# app-enforced usage limits.
AUTUMN_SECRET_KEY=
# Optional override for non-default Autumn API hosts.
AUTUMN_API_URL=https://api.useautumn.com

# All official and self-hosted deployments use WorkOS for auth.
# WorkOS default API/JWKS URLs are used by the backend. Only the credentials
# and your callback base URL above need to be configured here.
WORKOS_CLIENT_ID=client_01xxxxxxxxxxxxxxxxxxxxxxxx
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=replace-me-with-32-plus-characters

# Storage and service secrets
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_BASE_PATH=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
EXPO_TOKEN=
# Optional for store/development builds that use Google Maps through
# react-native-maps. Expo Go can render maps without these keys, but Android
# release builds require a restricted Google Maps API key.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
# Server-side notification delivery stays skipped until this is configured.
# APNs/FCM credentials remain managed outside git through EAS/provider setup.
EXPO_PUSH_ACCESS_TOKEN=

# Intentionally omitted from version control by default:
# - EAS owner / account metadata
# - EAS project IDs
# - APNs / FCM credentials
# - provider production secrets
