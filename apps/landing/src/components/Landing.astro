---
import type { Locale } from '../i18n/ui';
import { dict } from '../i18n/ui';
import Logo from './Logo.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dict[locale];
const altLocale = locale === 'en' ? 'de' : 'en';
const altHref = altLocale === 'en' ? '/en/' : '/';
const homeHref = locale === 'en' ? '/en/' : '/';
const privacyHref = locale === 'en' ? '/en/privacy/' : '/privacy/';
const repoUrl = 'https://github.com/cn0ss/beisammen';
const licenseUrl = `${repoUrl}/blob/main/docs/licensing.md`;

const waitlistEndpoint = (() => {
  const baseUrl = import.meta.env.PUBLIC_INSTANCE_BASE_URL?.trim();

  if (!baseUrl) {
    return '';
  }

  try {
    return new URL('/waitlist/join', baseUrl).toString();
  } catch {
    return '';
  }
})();

const navItems = [
  { id: 'idea', label: t.nav.why },
  { id: 'circles', label: t.nav.circles },
  { id: 'hosting', label: t.nav.hosting },
  { id: 'access', label: t.nav.waitlist },
];

const photoClasses = ['photo-1', 'photo-2', 'photo-3'];
const polaroidClasses = ['polaroid-1', 'polaroid-2', 'polaroid-3'];
---

<header class="site-header">
  <div class="container header-row">
    <a href={homeHref} class="brand" aria-label="beisammen">
      <Logo size={26} showWordmark={true} />
    </a>

    <nav class="header-nav" aria-label="Primary">
      {navItems.map((item) => (
        <a href={`#${item.id}`}>{item.label}</a>
      ))}
    </nav>

    <div class="header-side">
      <span class="availability">{t.masthead.availability}</span>
      <span class="lang-switch">
        <span class="on">{locale.toUpperCase()}</span>
        <span>/</span>
        <a href={altHref} data-lang-switch class="off">{altLocale.toUpperCase()}</a>
      </span>
    </div>
  </div>
</header>

<main class="landing">

  <!-- HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">{t.hero.eyebrow}</span>
        <h1 class="hero-title">
          {t.hero.titleLine1}<br />
          <span class="serif">{t.hero.titleItalic}</span><br />
          {t.hero.titleLine2}
        </h1>
        <p class="hero-lede">{t.hero.lede}</p>
        <div class="hero-actions">
          <a href="#access" class="btn btn-primary">
            {t.hero.primaryCta}
            <span class="arrow" aria-hidden="true">→</span>
          </a>
          <a href="#idea" class="btn btn-secondary">{t.hero.secondaryCta}</a>
        </div>
        <div class="hero-meta">
          {t.hero.metaItems.map((item) => <span>{item}</span>)}
        </div>
      </div>

      <div class="hero-stage" aria-hidden="true">
        {t.hero.polaroids.map((p, i) => (
          <figure class={`polaroid ${polaroidClasses[i]}`}>
            <div class={`photo ${photoClasses[i]}`}></div>
            <figcaption class="caption">
              <span>{p.caption}</span>
              <small>{p.date}</small>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- PROMISE -->
  <section id="idea" class="promise">
    <div class="promise-inner">
      <span class="eyebrow">{t.promise.eyebrow}</span>
      <h2>
        {t.promise.titlePlain} <span class="serif">{t.promise.titleItalic}</span>
      </h2>
      <p>{t.promise.body}</p>
    </div>
  </section>

  <!-- CIRCLES -->
  <section id="circles" class="section">
    <div class="container circles-shell">
      <div class="circles-head">
        <div class="section-head">
          <span class="eyebrow">{t.circles.eyebrow}</span>
          <h2>
            {t.circles.titlePlain} <span class="italic">{t.circles.titleItalic}</span>
          </h2>
        </div>
        <span class="label">{t.circles.label}</span>
      </div>

      <div class="circles-grid">
        {t.circles.cards.map((card, index) => {
          const variant = ['partner', 'family', 'friends'][index];
          return (
            <article class={`circle-card ${variant}`}>
              <div class="bloom"></div>
              <div class="meta">
                <span class="dot">{card.eyebrow}</span>
                <span>{card.size}</span>
              </div>
              <div>
                <h3>
                  {card.title.plain} <span class="serif">{card.title.italic}</span>
                </h3>
                <p>{card.body}</p>
              </div>
              <div class="avatar-stack" aria-hidden="true">
                {card.initials.map((letter) => (
                  <span class="avatar">{letter}</span>
                ))}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- PRINCIPLES -->
  <section class="section" style="padding-block: 0;">
    <div class="principles">
      <div class="section-head principles-head">
        <span class="eyebrow">{t.principles.eyebrow}</span>
        <h2>
          {t.principles.titlePlain} <span class="italic">{t.principles.titleItalic}</span>
        </h2>
      </div>

      <div class="principles-grid">
        {t.principles.items.map((item, index) => (
          <div class="principle">
            <span class="num">0{index + 1}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- HOSTING -->
  <section id="hosting" class="section">
    <div class="container hosting-shell">
      <div class="section-head">
        <span class="eyebrow">{t.hosting.eyebrow}</span>
        <h2>
          {t.hosting.titlePlain} <span class="italic">{t.hosting.titleItalic}</span>
        </h2>
      </div>

      <div class="hosting-grid">
        <article class="host-card cloud">
          <span class="host-tag">
            {t.hosting.cloud.tag}
            <span class="badge">{t.hosting.cloud.badge}</span>
          </span>
          <h3>
            {t.hosting.cloud.titlePlain} <span class="serif">{t.hosting.cloud.titleItalic}</span>
          </h3>
          <p>{t.hosting.cloud.body}</p>
          <ul class="host-list">
            {t.hosting.cloud.points.map((p) => <li>{p}</li>)}
          </ul>
        </article>

        <article class="host-card self">
          <span class="host-tag">
            {t.hosting.self.tag}
            <span class="badge">{t.hosting.self.badge}</span>
          </span>
          <h3>
            {t.hosting.self.titlePlain}<span class="serif">{t.hosting.self.titleItalic}</span>
          </h3>
          <p>{t.hosting.self.body}</p>
          <ul class="host-list">
            {t.hosting.self.points.map((p) => <li>{p}</li>)}
          </ul>
        </article>
      </div>

      <div class="providers">
        <span class="provider-label">{t.hosting.storageLabel}</span>
        <div class="provider-list">
          {t.hosting.storageProviders.map((p) => <span>{p}</span>)}
        </div>
      </div>

      <p class="host-note">{t.hosting.note}</p>
    </div>
  </section>

  <!-- WAITLIST -->
  <section id="access" class="section" style="padding-block: 0;">
    <div class="waitlist">
      <div class="waitlist-shell">
        <div>
          <span class="eyebrow">{t.waitlist.eyebrow}</span>
          <h2>
            {t.waitlist.titlePlain} <span class="serif">{t.waitlist.titleItalic}</span>
          </h2>
          <p>{t.waitlist.body}</p>
        </div>

        <form
          class="waitlist-form"
          data-waitlist-form
          data-endpoint={waitlistEndpoint}
        >
          <label class="field">
            <span>{t.waitlist.emailLabel}</span>
            <input
              type="email"
              name="email"
              required
              autocomplete="email"
              placeholder={t.waitlist.emailPlaceholder}
            />
          </label>

          <input type="hidden" name="locale" value={locale} />
          <input type="hidden" name="source" value="landing" />

          <button type="submit" class="btn btn-primary" data-waitlist-submit>
            {t.waitlist.primary}
            <span class="arrow" aria-hidden="true">→</span>
          </button>

          <p class="waitlist-footnote">{t.waitlist.footnote}</p>
          <p class="waitlist-status" data-waitlist-status aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>

  <footer class="site-footer">
    <div class="container footer-row">
      <p class="footer-tagline">{t.footer.tagline}</p>
      <nav class="footer-nav" aria-label="Secondary">
        <a href={repoUrl} rel="noopener noreferrer">{t.footer.source}</a>
        <a href={licenseUrl} rel="noopener noreferrer">{t.footer.license}</a>
        <a href={privacyHref}>{t.footer.privacy}</a>
      </nav>
      <span class="footer-meta">{t.footer.year}</span>
    </div>
  </footer>
</main>

<script
  is:inline
  define:vars={{
    waitlistEndpoint,
    successMessage: t.waitlist.success,
    duplicateMessage: t.waitlist.duplicate,
    errorMessage: t.waitlist.error,
    configErrorMessage: t.waitlist.configError,
  }}
>
  const form = document.querySelector('[data-waitlist-form]');
  if (form instanceof HTMLFormElement) {
    const button = form.querySelector('[data-waitlist-submit]');
    const status = form.querySelector('[data-waitlist-status]');
    const endpoint = form.dataset.endpoint || waitlistEndpoint;
    const setStatus = (message, state) => {
      if (!(status instanceof HTMLElement)) return;
      status.textContent = message;
      status.dataset.state = state;
    };
    const setPending = (pending) => {
      form.setAttribute('aria-busy', pending ? 'true' : 'false');
      if (button instanceof HTMLButtonElement) button.disabled = pending;
    };
    if (!endpoint) {
      setStatus(configErrorMessage, 'error');
      if (button instanceof HTMLButtonElement) button.disabled = true;
      return;
    }
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      setPending(true);
      setStatus('', 'idle');
      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          body: new FormData(form),
        });
        const payload = await response.json().catch(() => null);
        if (!response.ok || !payload?.ok) throw new Error('waitlist-submit-failed');
        form.reset();
        setStatus(
          payload.alreadyJoined ? duplicateMessage : successMessage,
          'success',
        );
      } catch {
        setStatus(errorMessage, 'error');
      } finally {
        setPending(false);
      }
    });
  }
</script>
