---
interface Props {
  size?: number;
  showWordmark?: boolean;
}
const { size = 26, showWordmark = true } = Astro.props;
const height = Math.round((size * 130) / 110);
---

<span class="logo" style={`--s: ${size}px`}>
  <svg
    width={size}
    height={height}
    viewBox="0 0 110 130"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    class="logo-mark"
  >
    <line
      x1="22" y1="12" x2="22" y2="118"
      stroke="currentColor" stroke-width="7.5" stroke-linecap="round"
    />
    <path
      d="M 22 62 Q 52 52, 66 75 Q 80 98, 66 112 Q 52 122, 22 115"
      stroke="currentColor" stroke-width="7.5" fill="none" stroke-linecap="round"
    />
    <circle cx="95" cy="115" r="8.5" fill="var(--ember, #c4654a)" />
  </svg>
  {showWordmark && <span class="logo-word">beisammen</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    color: var(--ink);
  }
  .logo-mark {
    display: block;
    flex-shrink: 0;
  }
  .logo-word {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.035em;
    line-height: 1;
    color: var(--ink);
  }
</style>
