---
// Root "/" page. Static site → we can't read the Accept-Language header at
// build time, so we ship a tiny inline script that inspects
// `navigator.languages` on load and forwards to `/en/` or `/de/`.
//
// Layered fallbacks, in order of preference:
//   1. localStorage `beisammen:lang` (a user who manually switched before)
//   2. `navigator.languages` matching `de` → /de/, anything else → /en/
//   3. <noscript> meta-refresh to /en/ (covers JS-disabled users)
//   4. Visible manual language picker if the script hasn't redirected yet
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>beisammen</title>
    <meta
      name="description"
      content="beisammen — a private photo and video app for small circles."
    />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0d0a07" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=JetBrains+Mono:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="alternate" hreflang="en" href="/en/" />
    <link rel="alternate" hreflang="de" href="/de/" />
    <link rel="alternate" hreflang="x-default" href="/en/" />
    <noscript>
      <meta http-equiv="refresh" content="0; url=/en/" />
    </noscript>
    <script is:inline>
      (function () {
        try {
          var LOCALES = ['en', 'de'];
          var stored = null;
          try {
            stored = localStorage.getItem('beisammen:lang');
          } catch (e) {}
          if (stored && LOCALES.indexOf(stored) !== -1) {
            window.location.replace('/' + stored + '/');
            return;
          }
          var langs = navigator.languages && navigator.languages.length
            ? navigator.languages
            : [navigator.language || 'en'];
          var picked = 'en';
          for (var i = 0; i < langs.length; i++) {
            var tag = String(langs[i]).toLowerCase().split('-')[0];
            if (LOCALES.indexOf(tag) !== -1) {
              picked = tag;
              break;
            }
          }
          window.location.replace('/' + picked + '/');
        } catch (err) {
          window.location.replace('/en/');
        }
      })();
    </script>
    <style>
      html,
      body {
        margin: 0;
        padding: 0;
        background: #0d0a07;
        color: #f1e7d2;
        font-family: 'Instrument Sans', system-ui, sans-serif;
        min-height: 100svh;
      }
      body {
        background:
          radial-gradient(1200px 800px at 90% -10%, rgba(244, 162, 97, 0.18), transparent 60%),
          radial-gradient(900px 700px at -10% 90%, rgba(159, 181, 144, 0.12), transparent 60%),
          #0d0a07;
      }
      .splash {
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1.1rem;
        padding: 2rem;
        text-align: center;
      }
      .splash-panel {
        width: min(36rem, 100%);
        padding: 2.2rem 2rem;
        border: 1px solid rgba(241, 231, 210, 0.12);
        border-radius: 2rem;
        background: rgba(22, 17, 12, 0.74);
        box-shadow: 0 24px 80px rgba(0, 0, 0, 0.28);
        backdrop-filter: blur(18px);
      }
      .splash-mark {
        display: inline-flex;
        gap: 2px;
      }
      .splash-mark span {
        display: inline-block;
        width: 28px;
        height: 28px;
        border: 1.5px solid #f1e7d2;
        border-radius: 50%;
      }
      .splash-mark span + span {
        margin-left: -10px;
      }
      .splash-eyebrow {
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 0.7rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: rgba(241, 231, 210, 0.62);
        margin: 0 0 1rem;
      }
      .splash h1 {
        font-family: 'Instrument Serif', Georgia, serif;
        font-size: clamp(2.4rem, 8vw, 4.8rem);
        font-weight: 400;
        letter-spacing: -0.04em;
        line-height: 0.92;
        margin: 0.9rem 0 0.4rem;
      }
      .splash p {
        font-size: 1rem;
        line-height: 1.6;
        color: rgba(241, 231, 210, 0.72);
        margin: 0 auto;
        max-width: 30rem;
      }
      .splash-links {
        display: flex;
        gap: 0.8rem;
        margin-top: 1.4rem;
        justify-content: center;
        flex-wrap: wrap;
      }
      .splash-links a {
        padding: 0.85em 1.4em;
        border: 1px solid rgba(241, 231, 210, 0.14);
        border-radius: 999px;
        font-family: 'JetBrains Mono', ui-monospace, monospace;
        font-size: 0.72rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        text-decoration: none;
        color: #f1e7d2;
        background: rgba(241, 231, 210, 0.04);
        transition: background 180ms ease, color 180ms ease, border-color 180ms ease, transform 180ms ease;
      }
      .splash-links a:hover {
        background: #f4a261;
        border-color: #f4a261;
        color: #0d0a07;
        transform: translateY(-1px);
      }
    </style>
  </head>
  <body>
    <main class="splash">
      <div class="splash-panel">
        <p class="splash-eyebrow">choose a language</p>
        <span class="splash-mark" aria-hidden="true">
          <span></span><span></span>
        </span>
        <h1>beisammen</h1>
        <p>A private photo and video app for small circles. English or Deutsch, then straight into the darkroom.</p>
        <div class="splash-links">
          <a href="/en/">English</a>
          <a href="/de/">Deutsch</a>
        </div>
      </div>
    </main>
  </body>
</html>
